# Protected runtime configuration: /opt/datathon2026/control/app.env (root:root 0600).
# Use the same application URL as the GitHub PUBLIC_BASE_URL repository variable.
PUBLIC_BASE_URL=https://yoosufsayyid.com/apps/datathon
BETTER_AUTH_URL=https://yoosufsayyid.com/apps/datathon
ORIGIN=https://yoosufsayyid.com
# The installer generates a random value. Keep it stable across releases.
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_FROM_THE_INSTALLER
# Optional integrations: add only the credentials used by your application.
DATABASE_AUTH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_SENDER=
# PUBLIC_APP_NAME and PUBLIC_R2_BUCKET_* are public build settings in GitHub.
# DATABASE_URL is fixed by Compose; do not set it here.
